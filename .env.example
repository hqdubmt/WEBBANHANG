# Copy file này thành .env và điền giá trị thực

NODE_ENV=development
APP_PORT=3001
APP_SECRET=change_this_secret_key
# Comma-separated allowed origins for CORS (production only; ignored in development)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=commerce_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ai_commerce
N8N_DB=n8n

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_PRODUCTS=products
MINIO_BUCKET_CONTENT=content
MINIO_BUCKET_VIDEOS=videos

N8N_USER=admin
N8N_PASSWORD=your_n8n_password
N8N_HOST=localhost

OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=your_openai_key

# -------------------------------------------
# QDRANT VECTOR DATABASE (V2)
# -------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# -------------------------------------------
# OBSERVABILITY (V2)
# -------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password
LOKI_PORT=3100
UPTIME_KUMA_PORT=3002

# -------------------------------------------
# SHOPEE AFFILIATE API
# Đăng ký: https://affiliate.shopee.vn → Tài khoản → API
# -------------------------------------------
SHOPEE_APP_ID=
SHOPEE_SECRET=

# -------------------------------------------
# LAZADA OPEN PLATFORM
# Đăng ký: https://open.lazada.com → Tạo App
# -------------------------------------------
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=

# -------------------------------------------
# TIKTOK SHOP API
# Đăng ký: https://seller-vn.tiktok.com/account/register (Partner account)
# -------------------------------------------
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# Social Publishing
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# -------------------------------------------
# EMAIL MARKETING (V2) - Agent 13
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=AI Commerce

# -------------------------------------------
# VIDEO FACTORY (V2) - Agent 08
# TTS: OpenAI hoặc Kokoro (local)
# -------------------------------------------
TTS_PROVIDER=openai
KOKORO_URL=http://localhost:8880
VIDEO_OUTPUT_DIR=/tmp/videos

# -------------------------------------------
# GOOGLE TRENDS (V2) - Agent 10
# -------------------------------------------
GOOGLE_TRENDS_GEO=VN

# -------------------------------------------
# PRICE INTELLIGENCE (V2) - Agent 11
# Thời gian kiểm tra giá (phút)
# -------------------------------------------
PRICE_CHECK_INTERVAL=60
PRICE_DROP_THRESHOLD=5

# -------------------------------------------
# V3: AUTH & SECURITY
# -------------------------------------------
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=2592000

# -------------------------------------------
# V3: WEBSOCKET
# -------------------------------------------
WS_PORT=3001

# -------------------------------------------
# V3: WEBHOOK SYSTEM
# -------------------------------------------
WEBHOOK_SECRET=your_webhook_secret

# -------------------------------------------
# V3: MULTI-TENANT (Enterprise)
# -------------------------------------------
TENANT_ID=default
ENABLE_MULTI_TENANT=false

# -------------------------------------------
# V3: AI LIVESTREAM AGENT
# -------------------------------------------
LIVESTREAM_PLATFORM=facebook
LIVESTREAM_STREAM_KEY=

# -------------------------------------------
# V3: MOBILE APP PUSH NOTIFICATIONS
# -------------------------------------------
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# -------------------------------------------
# V3: FRANCHISE / AFFILIATE NETWORK
# -------------------------------------------
AFFILIATE_COMMISSION_DEFAULT=8
AFFILIATE_COOKIE_DAYS=30

# -------------------------------------------
# V3: BACKUP
# -------------------------------------------
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30
