# ========================
# APP
# ========================
PORT=5000

# ========================
# DOCKER HUB
# ========================
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_HUB_PASSWORD=your_dockerhub_password

# ========================
# VPS / SSH
# ========================
VPS_HOST=your_vps_ip_or_domain
VPS_USER=ubuntu

# ========================
# TELEGRAM BOT
# ========================
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_TO=your_telegram_chat_id

# ========================
# GITHUB ACTIONS
# ========================
# PORT_RUN_CONTAINER: port mapping khi chay docker tren VPS, vi du: 5000:5000
PORT_RUN_CONTAINER=5000:5000

# PROD_ENV: noi dung file .env thuc te chay tren VPS (chi can PORT=5000)
PROD_ENV=PORT=5000
